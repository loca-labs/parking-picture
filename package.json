{
  "name": "@loca-labs/parking-picture",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-observe": "~58.0.19",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-widgets": "~58.0.28",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-share": "^12.3.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:preview:android": "npx eas-cli@latest build -p android --profile preview",
    "build:preview:ios": "npx eas-cli@latest build -p ios --profile preview",
    "build:preview:all": "npx eas-cli@latest build -p all --profile preview",
    "build:simulation": "npx eas-cli@latest build -p all --profile production-simulation",
    "build:simulation:android": "npx eas-cli@latest build -p android --profile production-simulation",
    "build:simulation:ios": "npx eas-cli@latest build -p ios --profile production-simulation",
    "build:android": "npx eas-cli@latest build -p android --profile production",
    "build:ios": "npx eas-cli@latest build -p ios --profile production",
    "build:all": "npx eas-cli@latest build -p all --profile production",
    "submit:android": "npx eas-cli@latest submit -p android --profile production",
    "submit:ios": "npx eas-cli@latest submit -p ios --profile production",
    "metadata:push": "npx eas-cli@latest metadata:push",
    "run:android": "expo run:android --variant release",
    "run:ios": "expo run:ios --configuration Release"
  },
  "private": true
}
