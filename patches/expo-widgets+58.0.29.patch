+  private func periodicEntries(from entries: [WidgetsTimelineEntry]) -> [WidgetsTimelineEntry]? {
+    let now = Date()
+    guard let base = entries.last(where: { $0.date <= now }) ?? entries.first,
+          let intervalMs = (base.props?["refreshIntervalMs"] as? NSNumber)?.doubleValue,
+          intervalMs >= 1000 else {
+      return nil
+    }
+    let interval = intervalMs / 1000
+    let anchor = ((base.props?["refreshAnchorMs"] as? NSNumber)?.doubleValue)
+      .map { Date(timeIntervalSince1970: $0 / 1000) } ?? now
+    // Land just after each boundary so labels computed from the entry date have already changed.
+    let margin: TimeInterval = 1
+    let count = max(1, min(60, Int(3600 / interval)))
+
+    var result = [WidgetsTimelineEntry(date: now, name: name, props: base.props, entryIndex: base.entryIndex)]
+    var step = (now.timeIntervalSince(anchor) / interval).rounded(.down) + 1
+    for _ in 0..<count {
+      let date = anchor.addingTimeInterval(step * interval + margin)
+      result.append(WidgetsTimelineEntry(date: date, name: name, props: base.props, entryIndex: base.entryIndex))
+      step += 1
+    }
+    return result
+  }
